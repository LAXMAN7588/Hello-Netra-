<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- =========================================================
         TOP STATUS BAR
         ========================================================= -->

    <TextView
        android:id="@+id/connectionStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:gravity="center"
        android:text="Initializing..."
        android:textColor="#00FF00"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- =========================================================
         CAMERA / FRAME DISPLAY
         ========================================================= -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/frameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="#111111"
            android:visibility="gone" />

        <com.example.objectdetection.DetectionOverlay
            android:id="@+id/detectionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- =========================================================
         STATUS / RESULTS
         ========================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="180dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/frameStatsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Frames: 0 / 6"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/fpsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FPS: 0.0"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/inferenceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inference: -- ms | Total: -- ms"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ramText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RAM: -- MB"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/countText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Objects Detected: 0"
                android:textColor="#00FF00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/breakdownText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detections: None"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/ttsStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TTS: Ready"
                android:textColor="#00FFFF"
                android:textSize="14sp"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/ocrStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OCR: Ready"
                android:textColor="#FFD740"
                android:textSize="14sp"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/ocrResultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingTop="2dp" />

        </LinearLayout>
    </ScrollView>

    <!-- =========================================================
         NETRA MODES
         ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btnPhoneCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Object Recognition"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnOcrMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OCR"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SOS"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- =========================================================
         OBJECT RECOGNITION / RASPBERRY PI
         ========================================================= -->

    <LinearLayout
        android:id="@+id/piModeButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <Button
            android:id="@+id/btnPiMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Raspberry Pi"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/piControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/piStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Raspberry Pi: Ready"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/piIpAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Raspberry Pi IP"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:singleLine="true"
                android:padding="10dp" />

            <Button
                android:id="@+id/btnDetectPi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OBJECT RECOGNITION"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPiOcr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OCR"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- =========================================================
         SOS CONTACT / ACTION PANEL
         ========================================================= -->

    <LinearLayout
        android:id="@+id/sosPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/sosStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SOS: Ready"
            android:textColor="#FF5252"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btnAddEmergencyContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Emergency Contact" />

        <Button
            android:id="@+id/btnSendSos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SEND SOS"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
